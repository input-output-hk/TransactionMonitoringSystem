# Per-network overrides for the Cardano preview testnet.
#
# Copy this template to .env.preview and edit OGMIOS_WS_URL, then launch with
# TMS_ENV=preview. These values are layered on top of the shared .env (later
# wins); shell environment variables win over both.
#
# .env.preview itself is gitignored; only this .example template is tracked.

CARDANO_NETWORK=preview
OGMIOS_WS_URL=ws://localhost:1337
# Host runs only: run.py binds uvicorn to this, which is how a host-run preview
# API coexists with a preprod one on 8000. Under docker compose the container's
# bind is pinned to 8000 and the published host port comes from ${API_PORT} in
# the top-level .env, so set it there to publish preview on 8001.
API_PORT=8001

# Kupo (address index) for on-demand historical backfill; empty disables it.
# See .env.preprod.example for what KUPO_URL means. KUPO_SINCE / KUPO_MATCH are
# Compose-interpolated and belong in the top-level .env, not here (they would be
# silently ignored in this file); see .env.example.
KUPO_URL=
