# Per-network overrides for Cardano mainnet.
#
# Copy this template to .env.mainnet and edit OGMIOS_WS_URL, then launch with
# TMS_ENV=mainnet. These values are layered on top of the shared .env (later
# wins); shell environment variables win over both.
#
# .env.mainnet itself is gitignored; only this .example template is tracked.
#
# Mainnet is the app's built-in default, so this file is not strictly required.
# Use it anyway when the host also has a .env.preprod / .env.preview: TMS_ENV
# defaults to preprod, so an unset TMS_ENV would silently layer the preprod file
# and point a mainnet deployment (and scripts/reset.sh) at the wrong network.
# TMS_ENV=mainnet plus this file makes the target explicit.
#
# Set TMS_ENV in BOTH places: in .env (docker compose reads it there to resolve
# the env_file path) and exported in the deploy shell profile. Host-side tools
# (run.py, app.cli, scripts/reset.sh) read TMS_ENV from the process environment
# before any dotenv file is loaded, so a value that lives only in .env leaves
# them on the preprod default and this file unread.

CARDANO_NETWORK=mainnet
# Your mainnet Ogmios v6 endpoint. Usually a separate node box rather than the
# bundled --profile ingestion stack: a mainnet node needs its own disk and sync.
OGMIOS_WS_URL=ws://localhost:1337
# API_PORT here applies to a HOST run (run.py binds uvicorn to it). Under docker
# compose it does nothing: the container's bind is pinned to 8000 in the compose
# file, and the published host port comes from ${API_PORT} interpolation, which
# reads the shell and the top-level .env only. To move the published port, set
# API_PORT in .env.
#
# 8000 is also the preprod template's port. Running two networks side by side on
# one host takes more than a second port: every service has a fixed
# container_name (tms-app, tms-postgres, ...) and fixed published ports, so the
# second stack needs its own COMPOSE_PROJECT_NAME and a distinct port for each
# published service.
API_PORT=8000

# Kupo (address index) for on-demand historical backfill of a contract whose
# activity predates this node's sync start. Leave empty to disable backfill
# (POST /api/v1/backfill returns 503).
#
# Of the three KUPO_* settings only KUPO_URL belongs in this file. KUPO_SINCE /
# KUPO_MATCH configure the bundled Kupo container through Compose ${...}
# interpolation, which reads the shell and the top-level .env ONLY: per-network
# files are injected into containers and are never seen by interpolation, so
# setting them here would be silently ignored. Set them in .env (see
# .env.example) and mind that Kupo's compose default is --since origin, which on
# mainnet means indexing the entire chain: hundreds of GB and days of sync.
KUPO_URL=

# Public dashboard URL, baked into emailed magic links. Set it whenever this
# deployment is reachable at anything other than http://localhost:8000, or the
# links resolve from nowhere (a silent failure: the mail still sends).
# KUPO_URL and APP_BASE_URL were deliberately left out of the compose
# `environment:` block so they can vary per network. Anything that block DOES
# name has to be set in .env instead. APPLICATION settings it does not name come
# from this file, including CARDANO_NETWORK, OGMIOS_WS_URL, LOG_LEVEL, the
# CH_RETENTION_DAYS_* knobs and the NOTIFY_* / WEBHOOK_* settings.
#
# The rule covers app settings only. A variable that Compose itself interpolates
# (`${VAR}` anywhere in docker-compose.yml: the *_MEM_LIMIT limits, the published
# ports, TMS_ENV, and the VITE_NETWORK build arg) is read from the shell or the
# top-level .env and never from this file, whether or not the `environment:`
# block mentions it. Setting VITE_NETWORK here in particular does nothing: it is
# a build-time argument for the frontend bundle. See RUNBOOK.md.
#APP_BASE_URL=https://tms.example.com

# Mainnet volume settings. Built-in defaults are sized for preprod. Only the
# safety pin below is set; the two volume knobs are left at their defaults
# deliberately, with sizing notes so the call stays explicit.

# Bounding the safety-net full rescan cuts its anti-join cost, but the full
# rescan IS the never-skip guarantee (app/analysis/engine.py:_poll_since): the
# incremental query only looks back UNANALYZED_OVERLAP_SECONDS, so anything
# unscored and older than this window is never picked up again. If ingestion
# outlives scoring (engine disabled for a migration, a crash-loop, a multi-day
# node resync) every row unscored beyond the window is permanently unscored,
# which is a missed detection. Leave unset (0 = unbounded) unless the rescan's
# cost is measured on this deployment; if you must bound it, pick a window that
# comfortably exceeds the longest plausible scoring outage, not hours.
# UNANALYZED_FULL_RESCAN_WINDOW_SECONDS=604800

# The raw Data-Lake store grew 196 MiB/day of disk blocks at mainnet volume over
# a measured 15-day window (about 5.7 GiB per 30 days), across roughly 46,000
# files/day, so budget inodes as well as bytes. Decide the pruning policy before
# a long run. Age-based pruning is set here; it is a no-op (logged as a warning
# by the retention sweep, so the disk keeps filling) while RAW_DATA_MAX_BYTES > 0,
# because a capped ClickHouse payload makes the raw store the only full copy of
# large transactions. Note that RAW_DATA_MAX_BYTES is NOT a raw-store size cap:
# it is the per-transaction cap on the ClickHouse raw_data column. The two are
# mutually exclusive for that reason, not because they bound the same store.
# RAW_STORE_RETENTION_DAYS=7

# Testnet-only harness flag: it force-enables the mainnet token registry on a
# testnet, where developers routinely mint iUSD/DJED/HOSKY lookalikes and the
# registry would flood Moderate with false positives. Both gates read
# `CARDANO_NETWORK == "mainnet" or FAKE_TOKEN_TESTNET_MODE`, so on mainnet the
# registry is already on and this flag is a no-op; it is pinned false only so
# this file stays correct if it is ever copied to a testnet host.
FAKE_TOKEN_TESTNET_MODE=false
