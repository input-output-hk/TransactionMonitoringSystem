# E2E tier environment. scripts/e2e.sh passes this file to docker compose as
# BOTH the interpolation env (--env-file) and the app's only env_file (via the
# docker-compose.e2e.yml override), so the tier is fully specified here and a
# developer's .env never leaks in. Nothing in this file is a secret: the stack
# lives on loopback for the duration of one test run.

# Host ports, all offset from the dev defaults so the tier runs beside a
# developer's stack.
POSTGRES_PORT=5534
CLICKHOUSE_HTTP_PORT=8124
CLICKHOUSE_NATIVE_PORT=9002
API_PORT=8100
MAILPIT_SMTP_PORT=1026
MAILPIT_HTTP_PORT=8026

# App settings. Dev mode permits the loopback bring-up; the base URL is what
# magic links embed and must match the app's host mapping above.
TMS_ALLOW_DEV_MODE=1
APP_BASE_URL=http://127.0.0.1:8100
CARDANO_NETWORK=preprod
CLUSTERING_ENABLED=false
# No node/Ogmios in this tier: the specs assert on seeded findings, not live
# ingestion. The app starts and serves with ingestion disconnected.
OGMIOS_WS_URL=ws://127.0.0.1:9/unreachable
